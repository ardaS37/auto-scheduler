<UserControl x:Class="AutoScheduler.UI.Views.TemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uiConverters="clr-namespace:AutoScheduler.UI.Converters">
    <UserControl.Resources>
        <uiConverters:EnumDisplayConverter x:Key="EnumDisplay" />
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- SOL: Günler -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top"
                       Style="{StaticResource SectionHeaderTextStyle}"
                       Text="Günler"/>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                <Button Style="{StaticResource IconButtonStyle}" Content="+" Command="{Binding AddDayCommand}" ToolTip="Yeni gün ekle"/>
                <Button Style="{StaticResource IconButtonStyle}" Content="-" Margin="6,0,0,0"
                        Command="{Binding RemoveDayCommand}" ToolTip="Seçili günü sil"/>
                <Button Content="Kopyala" Width="70" Margin="6,0,0,0"
                        Command="{Binding CopyDayCommand}" ToolTip="Seçili günün ders saatlerini kopyala"/>
            </StackPanel>

            <ListBox ItemsSource="{Binding Days}"
                     SelectedItem="{Binding SelectedDay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Padding="2"
                                 MinWidth="120"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- SAĞ: Ders Saatleri -->
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top"
                       Style="{StaticResource SectionHeaderTextStyle}"
                       Text="Ders Saatleri"/>

            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Margin="0,0,0,6">
                <Button Content="Standart 5 Gün / 8 Ders"
                        Command="{Binding ApplyStandardWeekTemplateCommand}"
                        ToolTip="Pazartesi-Cuma ve her gün 8 ders saati oluşturur"/>
                <Button Content="Ders Saati Ekle"
                        Margin="8,0,0,0"
                        Command="{Binding AddSlotCommand}" ToolTip="Yeni ders saati ekle"/>
                <Button Content="Ders Saati Sil"
                        Margin="6,0,0,0"
                        Command="{Binding RemoveSlotCommand}" ToolTip="Seçili ders saatini sil"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding SelectedDay.Slots}"
                      SelectedItem="{Binding SelectedSlot}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#"
                                        Binding="{Binding Index}"
                                        Width="40"
                                        IsReadOnly="True"/>
                    <DataGridTextColumn Header="Başlangıç"
                                        Binding="{Binding Start}"
                                        Width="120"/>
                    <DataGridTextColumn Header="Bitiş"
                                        Binding="{Binding End}"
                                        Width="120"/>
                    <DataGridTextColumn Header="Etiket"
                                        Binding="{Binding Label}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GroupBox DockPanel.Dock="Bottom"
                      Header="Seçili sınıf için bu günde izinli ders saatleri"
                      Margin="0,8,0,0">
                <GroupBox.Style>
                    <Style TargetType="GroupBox">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGroup}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GroupBox.Style>
                <StackPanel Margin="6">
                    <TextBlock Text="{Binding SelectedGroup.Name, StringFormat='Sınıf: {0}'}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding SelectedGroupSlotRules}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding SlotIndex, StringFormat='{}{0}. saat'}"
                                          IsChecked="{Binding IsAllowed, Mode=TwoWay}"
                                          ToolTip="İşaretliyken bu ders saati bu sınıf için kullanılabilir; işareti kaldırırsan program oluştururken bu saat bu sınıfa atanmaz"
                                          Margin="0,0,14,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </GroupBox>
        </DockPanel>


        <!-- SAĞ2: Sınıf/Şube -->
        <DockPanel Grid.Column="2" Margin="10,0,0,0">
            <TextBlock DockPanel.Dock="Top"
               Style="{StaticResource SectionHeaderTextStyle}"
               Text="Sınıf / Şube"/>

            <StackPanel DockPanel.Dock="Top"
                Orientation="Horizontal"
                Margin="0,0,0,6">
                <Button Style="{StaticResource IconButtonStyle}" Content="+" Command="{Binding AddGroupCommand}" ToolTip="Yeni sınıf/şube ekle"/>
                <Button Style="{StaticResource IconButtonStyle}" Content="-" Margin="6,0,0,0"
                Command="{Binding RemoveGroupCommand}" ToolTip="Seçili sınıf/şubeyi sil"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Groups}"
              SelectedItem="{Binding SelectedGroup}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              MouseDoubleClick="GroupsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ad"
                                Binding="{Binding Name}"
                                Width="*"/>
                    <DataGridTemplateColumn Header="Alan" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Track, Converter={StaticResource EnumDisplay}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Header="Öncelikli Sınıf"
                                             Binding="{Binding IsPriority, Mode=TwoWay}"
                                             Width="120"/>
                    <DataGridTextColumn Header="Öğrenci"
                                        Binding="{Binding Students.Count}"
                                        Width="65"
                                        IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock DockPanel.Dock="Bottom"
                       Text="Henüz sınıf eklenmedi. Başlamak için + butonu ile sınıf ekleyin ya da yeni proje rehberini kullanın."
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppMutedForegroundBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Groups.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>


    </Grid>
</UserControl>
