<Window x:Class="AutoScheduler.UI.Views.MoveLessonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dersi Taşı"
        Height="260"
        Width="460"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding LessonText}"
                   FontWeight="SemiBold"
                   FontSize="15"
                   Foreground="{DynamicResource AppAccentStrongBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Gün" Width="90" VerticalAlignment="Center"/>
            <ComboBox Width="260"
                      ItemsSource="{Binding Days}"
                      SelectedItem="{Binding SelectedDay}"
                      DisplayMemberPath="Name"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="Ders saati" Width="90" VerticalAlignment="Center"/>
            <ComboBox Width="260"
                      ItemsSource="{Binding Slots}"
                      SelectedItem="{Binding SelectedSlot}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Index}"/>
                            <Run Text=" - "/>
                            <Run Text="{Binding Label}"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Text="Taşıma sonrası diğer yerleşmiş dersler mümkün olduğunca korunarak program yeniden onarılır."
                   Foreground="{DynamicResource AppMutedForegroundBrush}"
                   TextWrapping="Wrap"
                   Margin="0,14,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="İptal" Width="86" IsCancel="True"/>
            <Button Content="Taşı ve Yeniden Üret" Width="150" Margin="8,0,0,0" IsDefault="True" Click="Move_Click"/>
        </StackPanel>
    </Grid>
</Window>
