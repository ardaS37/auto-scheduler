<Window x:Class="AutoScheduler.UI.Views.CourseConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ders Çakışması"
        Width="760"
        Height="460"
        MinWidth="620"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Ders Çakışması" FontSize="23" FontWeight="Black" Foreground="{DynamicResource AppAccentStrongBrush}"/>
            <TextBlock Text="Burada eşleştirilen iki ders, hangi sınıfta verildiğine bakılmaksızın aynı gün ve ders saatine yerleştirilmez. Alttan veya üstten ders alan öğrencilerin çakışmasını önlemek için kullanın."
                       Margin="0,7,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppMutedForegroundBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,8">
            <Button Content="Çakışma Kuralı Ekle" Command="{Binding AddPairCommand}"/>
            <Button Content="Seçiliyi Sil" Margin="8,0,0,0" Command="{Binding RemovePairCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Pairs}"
                  SelectedItem="{Binding SelectedPair}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Birinci ders" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding FirstCourse.Name}"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate><ComboBox ItemsSource="{Binding DataContext.Courses, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding FirstCourse, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name"/></DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Aynı anda verilmesin" Binding="{Binding DisplayName, StringFormat='{}{0}'}" Width="170" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="İkinci ders" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding SecondCourse.Name}"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate><ComboBox ItemsSource="{Binding DataContext.Courses, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding SecondCourse, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name"/></DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="3" Content="Kapat" Width="100" HorizontalAlignment="Right" Margin="0,14,0,0" IsCancel="True"/>
    </Grid>
</Window>
