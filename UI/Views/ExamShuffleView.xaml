<UserControl x:Class="AutoScheduler.UI.Views.ExamShuffleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uiConverters="clr-namespace:AutoScheduler.UI.Converters"
             DataContext="{Binding ExamShuffleVm}">
    <UserControl.Resources>
        <uiConverters:EnumDisplayConverter x:Key="EnumDisplay"/>
    </UserControl.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Sınav Karma" FontSize="26" FontWeight="Black" Foreground="{DynamicResource AppAccentStrongBrush}"/>
            <TextBlock Text="Katılan sınıfların öğrencilerini salon sıralarına kurallara göre karışık yerleştirin."
                       Margin="0,6,0,0" Foreground="{DynamicResource AppMutedForegroundBrush}"/>
        </StackPanel>

        <Expander Grid.Row="1" Header="Karma Kuralları ve Salon Düzeni" IsExpanded="True" Margin="0,16,0,0">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <CheckBox Content="Öğrenci kendi sınıfının salonunda sınava girmesin"
                              IsChecked="{Binding Store.ExamPreventOwnClassRoom}"/>
                    <CheckBox Content="Aynı sınıf düzeyindeki öğrenciler çevre sıralarda oturmasın"
                              Margin="0,8,0,0"
                              IsChecked="{Binding Store.ExamPreventSameGradeNeighbors}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Komşuluk kapsamı:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding NeighborRuleModes}"
                                  SelectedItem="{Binding Store.ExamNeighborRuleMode}"
                                  Width="230">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Toplu varsayılan sıra düzeni" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <StackPanel><TextBlock Text="Satır"/><TextBox Text="{Binding Store.DefaultSeatingRows, UpdateSourceTrigger=PropertyChanged}" Width="60"/></StackPanel>
                        <StackPanel Margin="10,0,0,0"><TextBlock Text="Sütun"/><TextBox Text="{Binding Store.DefaultSeatingColumns, UpdateSourceTrigger=PropertyChanged}" Width="60"/></StackPanel>
                        <StackPanel Margin="10,0,0,0"><TextBlock Text="Sıradaki öğrenci"/><TextBox Text="{Binding Store.DefaultStudentsPerDesk, UpdateSourceTrigger=PropertyChanged}" Width="100"/></StackPanel>
                        <Button Content="Tüm sınıflara uygula" Margin="12,18,0,0" Command="{Binding ApplyDefaultLayoutToAllCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Expander>

        <GroupBox Grid.Row="2" Header="Karmaya Katılacak Sınıflar ve Salonlar" Margin="0,14,0,0">
            <DataGrid ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="6" Height="185">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Katıl" Binding="{Binding IncludeInExamShuffle, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                    <DataGridTextColumn Header="Sınıf / Şube" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Sınıf düzeyi" Binding="{Binding GradeLevel}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Öğrenci" Binding="{Binding Students.Count}" Width="70" IsReadOnly="True"/>
                    <DataGridCheckBoxColumn Header="Özel düzen" Binding="{Binding UseCustomSeatingLayout, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                    <DataGridTextColumn Header="Satır" Binding="{Binding SeatingRows, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                    <DataGridTextColumn Header="Sütun" Binding="{Binding SeatingColumns, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                    <DataGridTextColumn Header="Sıradaki öğrenci" Binding="{Binding StudentsPerDesk, UpdateSourceTrigger=PropertyChanged}" Width="115"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource AccentCardBorderStyle}" Padding="12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Karıştır ve Yerleştir" Padding="16,7" Command="{Binding GenerateCommand}"/>
                    <StackPanel>
                        <TextBlock Text="{Binding GenerationSummary}" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#B45309" Margin="0,4,0,0"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Assignments}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,12,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Salon" Binding="{Binding Room}" Width="*"/>
                    <DataGridTextColumn Header="Yer" Binding="{Binding Seat}" Width="150"/>
                    <DataGridTextColumn Header="Ad" Binding="{Binding FirstName}" Width="110"/>
                    <DataGridTextColumn Header="Soyad" Binding="{Binding LastName}" Width="130"/>
                    <DataGridTextColumn Header="Okul No" Binding="{Binding StudentNumber}" Width="100"/>
                    <DataGridTextColumn Header="Sınıf" Binding="{Binding ClassName}" Width="100"/>
                    <DataGridTextColumn Header="Düzey" Binding="{Binding GradeLevel}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
