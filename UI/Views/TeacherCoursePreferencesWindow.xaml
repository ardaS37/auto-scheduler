<Window x:Class="AutoScheduler.UI.Views.TeacherCoursePreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detaylı Ders Tercihleri"
        Height="620"
        Width="760"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top"
                Style="{StaticResource AccentCardBorderStyle}"
                CornerRadius="10"
                Padding="10"
                Margin="0,0,0,10"
                Effect="{StaticResource CardShadowEffect}">
            <StackPanel>
                <TextBlock Text="{Binding Teacher.Name}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentStrongBrush}"/>
                <TextBlock Text="Dersleri verebilir, özellikle ister veya mümkünse istemez olarak işaretle."
                           Foreground="{DynamicResource AppMutedForegroundBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Kapat" Width="90" IsCancel="True"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding DetailedCourseChoices}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Ders" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="Verebilir"
                                        Binding="{Binding CanTeach, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="95"/>
                <DataGridCheckBoxColumn Header="İster"
                                        Binding="{Binding IsPreferred, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="85"/>
                <DataGridCheckBoxColumn Header="İstemez"
                                        Binding="{Binding IsUnwanted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="95"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
