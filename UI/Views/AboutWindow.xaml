<Window x:Class="AutoScheduler.UI.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hakkında"
        Height="260"
        Width="480"
        Icon="pack://application:,,,/Assets/icon.ico"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Hazırlayan: Arda Saplıoğlu" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="2026" FontSize="14" Margin="0,0,0,2"/>
            <TextBlock Text="Sapsoft Ders Programı Hazırlayıcı" FontSize="14" Margin="0,0,0,8"/>
            <TextBlock Text="v2.3.3" FontSize="14" FontWeight="SemiBold"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Kapat" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
