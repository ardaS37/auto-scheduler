<Window x:Class="AutoScheduler.UI.Views.TeacherSurveyImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Google Forms ile Öğretmen Anketi İçe Aktar"
        Width="1000"
        Height="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource AccentCardBorderStyle}"
                CornerRadius="14"
                Padding="16"
                Effect="{StaticResource CardShadowEffect}">
            <StackPanel>
                <TextBlock Text="Google Forms ile Öğretmen Anketi İçe Aktar"
                           FontSize="24"
                           FontWeight="Black"
                           Foreground="{DynamicResource AppAccentStrongBrush}"/>
                <TextBlock Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppMutedForegroundBrush}"
                           Text="1) Google Forms'ta aşağıdaki şablondaki soruları içeren bir anket oluşturun ve öğretmenlere gönderin. 2) Formun yanıtlarını Google E-Tablolar'a bağlayın. 3) E-Tablo'da Dosya &gt; İndir &gt; Virgülle Ayrılmış Değerler (.csv) ile CSV indirin. 4) İndirilen dosyayı aşağıdan açın veya içeriğini kutuya yapıştırıp İçe Aktar'a basın."/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Google Forms Şablonu" Margin="0,0,10,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="TemplateQuestionsListBox"/>

                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <Button Content="Şablonu CSV Olarak Kaydet..."
                                Click="SaveTemplate_Click"/>
                        <TextBlock Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource AppMutedForegroundBrush}"
                                   Text="Sütun başlıkları serbesttir: yukarıdaki anahtar kelimeleri (ör. 'ad soyad', 'telefon', 'verebileceği dersler') içerdiği sürece Google Forms'taki tam soru metni önemli değildir."/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="CSV İçeriği">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="140"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Dosya Aç..." Click="OpenFile_Click" Margin="0,0,8,0"/>
                        <Button Content="Kutuyu Temizle" Click="ClearBox_Click"/>
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             x:Name="CsvTextBox"
                             Margin="0,10,0,0"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"/>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <WrapPanel>
                            <CheckBox x:Name="AutoCreateCoursesCheckBox" Content="Eksik dersi otomatik oluştur" IsChecked="True" Margin="0,0,16,0"/>
                            <CheckBox x:Name="UpdateExistingCheckBox" Content="Var olan öğretmenleri güncelle" IsChecked="True"/>
                        </WrapPanel>
                        <Button Content="İçeri Aktar"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Right"
                                Width="140"
                                Click="Import_Click"/>
                    </StackPanel>

                    <GroupBox Grid.Row="3" Header="Sonuç / Uyarılar" Margin="0,12,0,0">
                        <ListBox x:Name="ResultListBox"/>
                    </GroupBox>
                </Grid>
            </GroupBox>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Style="{StaticResource CardBorderStyle}"
                Padding="10">
            <TextBlock x:Name="StatusTextBlock"
                       Text="İşlem bekleniyor."
                       Foreground="{DynamicResource AppAccentStrongBrush}"/>
        </Border>
    </Grid>
</Window>
